{
  "name": "tesseract",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:build": "tsx scripts/build-db.ts",
    "demo:check": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.verify.json scripts/demo-check.ts",
    "concepts:generate": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.verify.json scripts/generate-concepts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@base-ui/react": "^1.9.0",
    "@duckdb/node-api": "^2.0.0-r.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
