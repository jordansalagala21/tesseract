# Copy to .env.local and fill in. NEVER commit .env.local.
# All of these are SERVER-ONLY. Do not prefix with NEXT_PUBLIC_ (except the SDK key, see below).

# --- CoStar static kit (local path to the unzipped sponsor kit) ---
COSTAR_KIT_DIR=/absolute/path/to/costar-hackathon-kit
# DuckDB file built by `npm run db:build` (gitignored)
DUCKDB_PATH=./data/tesseract.duckdb

# --- Matterport Model API (GraphQL, HTTP Basic: key id + secret) ---
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# --- Matterport Showcase SDK (browser key; allowed domain is currently localhost only) ---
NEXT_PUBLIC_MATTERPORT_SDK_KEY=

# --- Vexcel API v2 (sent as the x-api-key header, server-side only) ---
VEXCEL_API_KEY=

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=
# Optional model overrides
ANTHROPIC_MODEL_ORCHESTRATOR=claude-opus-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
