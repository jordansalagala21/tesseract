costar-hackathon-kit/
costar-hackathon-kit.zip
*.jsonl
/data/*
!/data/README.md

# ---------- local databases ----------
*.duckdb
*.duckdb.wal
*.db
*.sqlite

# ---------- downloaded imagery & API responses (licensed / temporary) ----------
/.cache/
/imagery/
/tmp/
**/api-responses/
*.dxf

# ---------- scratch ----------
/scratch/
/scratchpad/
*.local.md

# ---------- misc ----------
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# ---------- generated concept images (derived from sponsor imagery; npm run concepts:generate) ----------
/public/concepts/
