# ---------- dependencies ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- build / test output ----------
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ---------- secrets: NEVER commit ----------
.env
.env.*
!.env.example
*.pem
*.key
*.creds
*.creds.env
credentials.json
service-account*.json

# ---------- sponsor data (licensed; each dev keeps a local copy) ----------
